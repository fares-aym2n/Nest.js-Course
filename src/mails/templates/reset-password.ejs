<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />
    <title>Reset Password</title>
  </head>

  <body
    style="
      margin: 0;
      padding: 0;
      background-color: #f4f4f4;
      font-family: Arial, sans-serif;
    "
  >
    <div
      style="
        max-width: 600px;
        margin: 40px auto;
        background-color: #ffffff;
        padding: 40px;
        border-radius: 10px;
      "
    >
      <h1 style="color: #333333; margin-bottom: 20px">
        Reset Your Password
      </h1>

      <p
        style="font-size: 16px; color: #555555; line-height: 1.6"
      >
        Hello, <%= user.username %>!
      </p>

      <p
        style="font-size: 16px; color: #555555; line-height: 1.6"
      >
        We received a request to reset the password for your
        account.
      </p>

      <p
        style="font-size: 16px; color: #555555; line-height: 1.6"
      >
        Click the button below to create a new password.
      </p>

      <div style="text-align: center; margin: 30px 0">
        <a
          href="<%= resetPasswordLink %>"
          style="
            display: inline-block;
            padding: 14px 25px;
            background-color: #007bff;
            color: #ffffff;
            text-decoration: none;
            border-radius: 6px;
            font-size: 16px;
          "
        >
          Reset Your Password
        </a>
      </div>

      <p
        style="font-size: 14px; color: #777777; line-height: 1.5"
      >
        This link will expire after a limited time for security
        reasons.
      </p>

      <p
        style="font-size: 14px; color: #777777; line-height: 1.5"
      >
        If you did not request a password reset, you can safely
        ignore this email.
      </p>

      <hr
        style="
          border: 0;
          border-top: 1px solid #eeeeee;
          margin: 30px 0;
        "
      />

      <p
        style="
          font-size: 12px;
          color: #999999;
          text-align: center;
        "
      >
        © 2026 Your App. All rights reserved.
      </p>
    </div>
  </body>
</html>
